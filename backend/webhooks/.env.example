# ─── Sensei — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── GitHub App ───────────────────────────────────────────────────
# Create at: https://github.com/settings/apps
GITHUB_APP_ID=your_app_id
GITHUB_PRIVATE_KEY=base64_encoded_private_key_here
WEBHOOK_SECRET=your_webhook_secret

# ─── Database (PostgreSQL) ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── ChromaDB ────────────────────────────────────────────────────
CHROMADB_URL=http://localhost:8000

# ─── Server ──────────────────────────────────────────────────────
PORT=3001

# ─── AI / LLM (Groq — free tier) ────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Optional: Ingestion Pipeline ───────────────────────────────
# Only needed if running the ingestion CLI manually
# GITHUB_TOKEN=ghp_your_personal_access_token

# ─── Optional: Escalation ───────────────────────────────────────
# SENIOR_ENGINEER_USERNAME=your_github_username
